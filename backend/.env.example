# Copy to .env and fill in real values. Never commit .env to Git.
# Supabase PostgreSQL connection string (SQLAlchemy format)
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# JWT signing secret (required in production; dev uses an insecure fallback with a warning)
RAKTOSETU_SECRET_KEY=[YOUR-SECRET-KEY]
# Set to "production" to enforce SECRET_KEY and fail fast without it
RAKTOSETU_ENV=development
